{
  "name": "nycking-server",
  "version": "1.0.0",
  "description": "NYCKING Cloud Run API Server — Thai-Chinese Voice Translator Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node -r dotenv/config src/index.ts",
    "docker:build": "docker build -t nycking-server .",
    "docker:run": "docker run -p 8080:8080 --env-file .env nycking-server"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^1.44.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "node-fetch": "^2.7.0",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-fetch": "^2.6.11",
    "dotenv": "^17.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
